# Public development template. The installer writes real local settings.
# No database password, signing key or operator address belongs in this file.
NETWORK_CONFIG_URL=https://config.filetrust.io/v1/network-config
RPC_URL=http://127.0.0.1:8545
FILETRUST_CHAIN=cosmos
NEXT_PUBLIC_CHAIN_ID=31338
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_FTU_PRICE_URL=
NEXT_PUBLIC_MULTICALL3_ADDRESS=
PORT=3001
EXPLORER_BIND=127.0.0.1

# Default PostgreSQL and ClickHouse installations use loopback only.
# The helper creates these stores and generates distinct owner/reader secrets.
EXPLORER_POSTGRES_PORT=5433
EXPLORER_CLICKHOUSE_PORT=8123
EXPLORER_CLICKHOUSE_TCP_PORT=9100
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=filetrust
PGDATABASE=filetrust_explorer
PGPASSWORD=
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=filetrust_explorer
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
