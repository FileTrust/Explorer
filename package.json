{
  "name": "filetrust-explorer",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "node scripts/start_web.mjs",
    "lint": "eslint .",
    "index": "node scripts/indexer.mjs",
    "index:watch": "node scripts/index_watch.mjs",
    "index:recent": "INDEX_RECENT_BLOCKS=250 node scripts/indexer.mjs",
    "index:dry": "INDEX_DRY_RUN=1 node scripts/indexer.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "index:reproject": "INDEX_REPROJECT=1 node scripts/indexer.mjs",
    "index:reset": "node scripts/reset_index.mjs",
    "verify:projection": "node scripts/verify_projection.mjs",
    "verify:rollups": "node scripts/verify_rollups.mjs",
    "verify:ingest": "node scripts/verify_ingest.mjs"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "viem": "^2.21.19"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
